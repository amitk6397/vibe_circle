APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
# MySQL production/development example:
DATABASE_URL=mysql+pymysql://vibecircle:change-me@127.0.0.1:3306/vibecircle?charset=utf8mb4
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_BASE_URL=http://127.0.0.1:8000
FIREBASE_CREDENTIALS_PATH=./your-project-firebase-adminsdk.json
AGORA_APP_ID=your-32-character-agora-app-id
AGORA_APP_CERTIFICATE=your-primary-agora-app-certificate
AGORA_TOKEN_TTL_SECONDS=3600
CALL_RING_TIMEOUT_SECONDS=60
CALL_JOIN_TIMEOUT_SECONDS=120
CALL_DURATION_OPTIONS=5,10,15,30
FREE_CONVERSATIONS_PER_WEEK=5
FREE_MESSAGES_PER_CONVERSATION=10
MESSAGE_REQUESTS_PER_DAY=10
MESSAGE_REQUEST_EXPIRY_HOURS=72
DUMMY_PAYMENTS_ENABLED=true
PLATFORM_COMMISSION_PERCENT=20
CREATOR_SETTLEMENT_DAYS=7
